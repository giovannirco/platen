# Copy to deploy/.env. Compose reads that file and refuses to start when the
# two required values are empty. Generate each with: openssl rand -hex 24
# Do not commit deploy/.env.

# Bearer token for the API, the web interface and MCP. One token can do everything.
PLATEN_AUTH_TOKENS=

# Signs print confirmations. Keep it stable across restarts.
PLATEN_STATE_SECRET=

# Optional. Use a Paperless user that can upload and search, not an admin.
PLATEN_PAPERLESS_TOKEN=
